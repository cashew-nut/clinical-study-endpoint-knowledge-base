# AACT (Aggregate Analysis of ClinicalTrials.gov) read-only Postgres credentials.
# Register for free at https://aact.ctti-clinicaltrials.org
#
# Copy this file to `.env` (gitignored) and fill in your own values.
# Never commit `.env` or hardcode these values anywhere in source.
PGHOST=aact-db.ctti-clinicaltrials.org
PGPORT=5432
PGDATABASE=aact
PGUSER=
PGPASSWORD=
