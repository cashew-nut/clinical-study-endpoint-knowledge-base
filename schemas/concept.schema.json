{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cashew-nut/clinical-study-endpoint-knowledge-base/schemas/concept.schema.json",
  "title": "Canonical endpoint concept (Layer A)",
  "description": "A reusable clinical meaning, independent of any single study. Layer A carries only what is true of the concept wherever it is used; anything a protocol chooses belongs in Layer B.",
  "type": "object",
  "required": ["concept_id", "label", "definition", "therapeutic_areas", "structure", "status"],
  "additionalProperties": false,
  "properties": {
    "concept_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "label": { "type": "string", "minLength": 1 },
    "abbreviation": { "type": "string" },
    "definition": { "type": "string", "minLength": 1 },
    "synonyms": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Surface forms seen in registries and protocols. Used as classifier evidence, not as the rule source."
    },
    "therapeutic_areas": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
      "description": "term_ids from the therapeutic_area axis. 'cross_cutting' for TA-independent concepts."
    },
    "structure": {
      "type": "object",
      "description": "The endpoint parameter model. Each key is an axis_id; each value is a term_id from that axis.",
      "required": ["endpoint_form", "measurement_concept", "reference_type", "direction", "scale_type"],
      "additionalProperties": false,
      "properties": {
        "endpoint_form": { "type": "string" },
        "measurement_concept": { "type": "string" },
        "reference_type": { "type": "string" },
        "direction": { "type": "string" },
        "scale_type": { "type": "string" },
        "default_summary_measure": { "type": "string" },
        "default_timepoint_selection": { "type": "string" }
      }
    },
    "definitional_threshold": {
      "description": "A threshold that is part of the concept's definition (ORR is not ORR without RECIST's 30%). Null when the threshold is a protocol choice and therefore belongs in Layer B.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["kind", "operator", "value"],
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string" },
            "operator": { "type": "string" },
            "value": { "type": ["number", "string"] },
            "unit": { "type": "string" },
            "applies_to": { "type": "string" },
            "note": { "type": "string" }
          }
        }
      ]
    },
    "typical_units": {
      "type": "array",
      "items": { "type": "string" },
      "description": "term_ids from the unit axis."
    },
    "governing_criteria": {
      "type": "array",
      "description": "The published criteria that define how the measurement is derived.",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "citation": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    },
    "components": {
      "type": "array",
      "description": "For composite concepts, the constituent concepts or measurements.",
      "items": {
        "type": "object",
        "required": ["label"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string" },
          "concept_id": { "type": "string" },
          "measurement_concept": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "related_concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["concept_id", "relation"],
        "additionalProperties": false,
        "properties": {
          "concept_id": { "type": "string" },
          "relation": {
            "type": "string",
            "enum": ["narrower_than", "broader_than", "variant_of", "component_of", "often_paired_with", "supersedes"]
          },
          "note": { "type": "string" }
        }
      }
    },
    "external_mappings": {
      "type": "array",
      "items": { "$ref": "axis.schema.json#/$defs/external_mapping" }
    },
    "usdm_hints": {
      "type": "object",
      "description": "Defaults used when projecting to USDM. Overridable per study in Layer B.",
      "additionalProperties": false,
      "properties": {
        "endpoint_text_template": {
          "type": "string",
          "description": "USDM SyntaxTemplate text with [Tag] parameter placeholders."
        },
        "objective_text_template": { "type": "string" },
        "suggested_activity_labels": { "type": "array", "items": { "type": "string" } }
      }
    },
    "status": { "type": "string", "enum": ["draft", "reviewed", "deprecated"] },
    "notes": { "type": "string" }
  }
}
